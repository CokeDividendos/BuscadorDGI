# Example Streamlit secrets configuration
# Copy this file to secrets.toml and add your actual credentials

# ─────────────────────────────────────────────────────────
# Neon PostgreSQL (REQUERIDO para persistencia en producción)
# ─────────────────────────────────────────────────────────
# Obtén tu connection string en: https://console.neon.tech
# Proyecto → Connection Details → Connection string
[neon]
database_url = "postgresql://user:password@ep-algo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─────────────────────────────────────────────────────────
# Admin user credentials (opcional pero recomendado)
# ─────────────────────────────────────────────────────────
# Si se configura, el admin se auto-crea en cada arranque.
# Útil en Streamlit Cloud donde el filesystem es efímero.
[admin]
email = "admin@example.com"
password = "your-secure-password-here"
